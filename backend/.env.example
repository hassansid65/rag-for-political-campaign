# =============================================================================
#  Real-Time RAG — Voice AI Campaign Assistant
#  Copy to backend/.env and fill in the three secrets marked REQUIRED.
# =============================================================================

# ----------------------------------------------------------------- REQUIRED
# Claude (generation). Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Azure Speech (STT + TTS + visemes). Azure Portal → Speech service → Keys.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=eastus2

# ---------------------------------------------------------------------- app
ENVIRONMENT=dev
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000
MAX_UPLOAD_MB=50

# ------------------------------------------------------------- vector store
# milvus      → Milvus standalone or Zilliz Cloud (production default)
# milvus_lite → embedded file-based Milvus (Linux/macOS only)
# local       → NumPy flat index fallback (works everywhere, incl. Windows)
VECTOR_BACKEND=milvus
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=default
COLLECTION_NAME=campaign_chunks

MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE
HNSW_M=24
HNSW_EF_CONSTRUCTION=200
HNSW_EF_SEARCH=96

# ---------------------------------------------------------------- embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_SEQ_LENGTH=512
EMBEDDING_CACHE_SIZE=2048
EMBEDDING_USE_ONNX=false

# ------------------------------------------------------------------ chunking
CHUNK_SIZE=700
CHUNK_OVERLAP=120
MIN_CHUNK_CHARS=80
PARENT_WINDOW_CHARS=1800
ENABLE_PARENT_EXPANSION=true

# ----------------------------------------------------------------- retrieval
RETRIEVAL_TOP_K=5
CANDIDATE_TOP_K=30
RERANK_TOP_N=3
SIMILARITY_THRESHOLD=0.30
RERANK_SCORE_THRESHOLD=-2.0
RRF_K=60
DENSE_WEIGHT=1.0
SPARSE_WEIGHT=0.7
ENABLE_HYBRID=true
ENABLE_RERANK=true

# Reranking is cascaded: a cheap cross-encoder scores all candidates, then the
# precise BGE reranker rescores only the shortlist.
#   auto    → probe RAM/GPU at startup and pick cascade or fast (default)
#   fast    → MiniLM-L6 only                  ~250ms  / 16 candidates
#   cascade → MiniLM-L6 (all) → BGE (top 4)   ~670ms  / 16 candidates
#   single  → BGE over all candidates         ~1690ms / 16 candidates
# BGE-reranker-base needs ~2.5 GB free; below that it pages and costs ~5x, which
# is exactly what `auto` exists to avoid. A CUDA device makes cascade ~free.
RERANK_MODE=auto
RERANKER_MODEL=BAAI/bge-reranker-base
RERANKER_FAST_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CASCADE_KEEP=4
RERANKER_DEVICE=cpu
# 256 tokens covers a 700-char chunk; 512 paid attention cost for tokens the
# model then truncated away.
RERANKER_MAX_LENGTH=256
RERANK_CANDIDATE_CAP=16
MAX_CONTEXT_CHARS=6000

# ----------------------------------------------------------------------- LLM
LLM_MODEL=claude-opus-5
LLM_MAX_TOKENS=1024
# low keeps time-to-first-token minimal, which is what a voice turn needs.
LLM_EFFORT=low
# off = thinking disabled (no pre-answer latency). adaptive = let the model decide.
LLM_THINKING=off
LLM_ENABLE_PROMPT_CACHE=true
LLM_TIMEOUT_S=60
LLM_MAX_RETRIES=2
REWRITE_MODEL=claude-haiku-4-5
ENABLE_LLM_QUERY_REWRITE=true

# -------------------------------------------------------------------- memory
MEMORY_MAX_TURNS=8
SESSION_TTL_S=3600

# --------------------------------------------------------------------- cache
ENABLE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_THRESHOLD=0.97
SEMANTIC_CACHE_SIZE=512
SEMANTIC_CACHE_TTL_S=900

# --------------------------------------------------- streaming voice tuning
PARTIAL_MIN_CHARS=12
PARTIAL_MIN_TOKENS=3
PARTIAL_DEBOUNCE_MS=180
PARTIAL_REUSE_THRESHOLD=0.94

# -------------------------------------------------------------------- speech
AZURE_SPEECH_ENDPOINT=

# DragonHD voices sound markedly more natural than standard neural voices and
# (verified live) still emit the viseme events the avatar's lip-sync needs.
# They do ignore `mstts:express-as` and `prosody`, so the SSML builder emits a
# reduced payload for them — including those elements can fail the request
# outright rather than degrade. Presets: meera, aarti, ava.
#   DragonHD      : en-IN-Meera:DragonHDLatestNeural
#                   en-IN-Aarti:DragonHDLatestNeural
#                   en-US-Ava:DragonHDLatestNeural
#   standard      : en-IN-NeerjaNeural, en-IN-PrabhatNeural, te-IN-ShrutiNeural
AZURE_TTS_VOICE=en-IN-Meera:DragonHDLatestNeural
# Applies to standard neural voices only; DragonHD ignores it.
AZURE_TTS_RATE=+8%
AZURE_STT_LANGUAGE=en-IN
AZURE_STT_LANGUAGES=en-IN,te-IN,hi-IN

# ------------------------------------------------------------------- lipsync
ENABLE_LIPSYNC=true
# Leave blank to auto-detect (backend/bin, Rhubarb-Lip-Sync-*, or PATH).
RHUBARB_PATH=
FFMPEG_PATH=

# ------------------------------------------------------------------ parsing
USE_UNSTRUCTURED=0
